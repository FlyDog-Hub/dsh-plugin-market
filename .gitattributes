* text=auto

# 图片按二进制处理，避免行尾/编码转换破坏内容
*.png binary
*.jpg binary
*.ico binary

# PowerShell 脚本在 Windows 上用 CRLF；其中带中文的 .ps1 依赖 UTF-8 BOM 才能被 PS 5.1 正确解析，
# 该 BOM 属于文件内容，不会被行尾归一化去掉
*.ps1 text eol=crlf

*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
